{
  "manifest_version": "0.3",
  "name": "facehunch",
  "display_name": "Facehunch",
  "version": "1.0.0",
  "description": "Connect your Facehunch account to an MCP client.",
  "long_description": "get_profile reads only your own account ID and email. It does not identify other people, perform face searches, access photographs or search reports, or spend credits.",
  "author": {
    "name": "Codex"
  },
  "homepage": "https://facehunch.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/facehunch/mcp-server"
  },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=22"
    }
  },
  "license": "MIT"
}
